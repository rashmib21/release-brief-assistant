# Copy to .env and fill in. Never commit the real .env file.

# SQLite for local work, a hosted Postgres URL (for example Neon) in production
DATABASE_URL=sqlite:///./app.db

# "gemini" for real AI calls, "mock" for the offline deterministic provider (used by tests)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60

# Protects the API key on a public deployment
ANALYZE_RATE_LIMIT_PER_MINUTE=10

LOG_LEVEL=INFO
# Where the built React app lives, relative to backend/ (set automatically in Docker)
FRONTEND_DIST=../frontend/dist
